---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, TIMELINE } from '../consts';

const featured = [
  {
    title: 'Pameran Tunggal — Nuanu 2026',
    cat: 'Pameran',
    img: 'https://images.unsplash.com/photo-1531058020387-3be344556be6?auto=format&fit=crop&w=1200&h=900&q=80',
    alt: 'Ruang pameran dengan pencahayaan temaram',
    href: '/blog/dibalik-pameran-nuanu/',
    desc: 'Instalasi multimedia di Nuanu Creative City — Juni 2026.',
  },
  {
    title: 'Jimmy Flaeur — CD Album',
    cat: 'Musik',
    img: 'https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?auto=format&fit=crop&w=1200&h=900&q=80',
    alt: 'Studio rekaman indie dengan pencahayaan hangat',
    href: '/blog/jimmy-flaeur-album/',
    desc: 'Album kolaborasi dengan 10+ musisi. Psychedelic folk dari Bali.',
  },
  {
    title: '5 Lukisan Cat Genteng',
    cat: 'Lukisan',
    img: '/art/anger-of-the-sun.svg',
    alt: 'Lukisan Anger Of The Sun',
    href: '/art/',
    desc: 'Medium cat genteng. Anger Of The Sun, Bright Blue Sky, Dance, Fake Rainbow, Flame Dance.',
  },
  {
    title: 'Pilgrimage Worldwide Tour',
    cat: 'Tur',
    img: 'https://images.unsplash.com/photo-1493863641943-9b68992a8d07?auto=format&fit=crop&w=1200&h=900&q=80',
    alt: 'Pemandangan perkotaan saat senja',
    href: '/blog/pilgrimage-tour-2024/',
    desc: 'Tur internasional — Jepang, LA, Taiwan. 12 karya dalam 3 bulan.',
  },
];
---
<BaseLayout title={SITE.name} description={SITE.description}>
  <!-- HERO -->
  <section class="relative overflow-hidden border-b border-base-300">
    <div class="container-wide grid items-center gap-12 py-20 md:grid-cols-12 md:py-32">
      <div class="md:col-span-7">
        <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-base-300 bg-base-200/40 px-3 py-1 font-mono text-xs text-base-content/70">
          <span class="inline-block h-1.5 w-1.5 animate-pulse rounded-full bg-primary"></span>
          {SITE.brandTag} · {SITE.livePlace}
        </p>
        <h1 class="font-display text-5xl font-medium leading-[1.05] sm:text-6xl md:text-7xl lg:text-8xl">
          Collection of souls<br />
          who sailed the<br />
          <em class="text-primary">ark of peace</em>.
        </h1>
        <p class="mt-6 max-w-xl text-lg text-base-content/75">
          {SITE.name} adalah rumah kecil untuk karya-karya <strong>{SITE.founderAlias}</strong> dan teman-teman — musik, seni rupa, fotografi, tulisan. Sebuah langkah lain dari seni.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/works/" class="btn btn-primary">Lihat Karya</a>
          <a href="/about/" class="btn btn-outline">Tentang Kami</a>
          <a href="/contact/" class="btn btn-ghost">Kolaborasi →</a>
        </div>
      </div>

      <div class="relative md:col-span-5">
        <div class="relative aspect-[4/5] overflow-hidden rounded-box border border-base-300 shadow-xl">
          <img
            src="https://images.unsplash.com/photo-1551244072-5d12893278ab?auto=format&fit=crop&w=900&h=1125&q=80"
            alt="Suasana studio kreatif Another Waltz"
            class="absolute inset-0 h-full w-full object-cover"
            loading="eager"
            decoding="async"
          />
          <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-base-100/95 to-transparent p-5">
            <p class="font-display text-lg">Ruby Room Studio</p>
            <p class="text-xs text-base-content/60">Canggu · 2024–sekarang</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MOTTO -->
  <section class="bg-base-200/30 py-12">
    <div class="container-wide">
      <p class="text-center font-display text-2xl italic leading-relaxed text-base-content/80 md:text-3xl">
        "{SITE.motto}"
      </p>
    </div>
  </section>

  <!-- FEATURED -->
  <section class="container-wide py-16 md:py-24">
    <div class="mb-10 flex items-end justify-between gap-4">
      <div>
        <p class="section-label">Sorotan</p>
        <h2 class="font-display text-3xl sm:text-4xl">Karya Pilihan</h2>
      </div>
      <a href="/works/" class="btn btn-sm btn-ghost">Semua karya →</a>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {featured.map(f => (
        <a href={f.href}
           class="card-hover group relative overflow-hidden rounded-box border border-base-300/60 bg-base-200/30">
          <div class="aspect-[4/5] overflow-hidden">
            <img
              src={f.img}
              alt={f.alt}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
          </div>
          <div class="space-y-1 p-4">
            <p class="font-mono text-[10px] uppercase tracking-widest text-primary">{f.cat}</p>
            <h3 class="font-display text-lg leading-tight">{f.title}</h3>
            <p class="text-sm text-base-content/65">{f.desc}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- TIMELINE -->
  <section class="container-wide py-16 md:py-24">
    <p class="section-label">~/timeline</p>
    <h2 class="mb-10 font-display text-3xl sm:text-4xl">Yang sudah dan sedang kami lakukan.</h2>
    <ol class="relative space-y-6 border-l border-base-300/60 pl-6">
      {TIMELINE.map(t => (
        <li class="relative">
          <span class="absolute -left-[31px] top-1.5 inline-block h-3 w-3 rounded-full bg-primary ring-4 ring-base-100"></span>
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="font-display text-xl">{t.event}</h3>
            <span class="text-xs uppercase tracking-widest text-base-content/50">{t.year}</span>
          </div>
          <span class="mt-2 inline-block rounded-full border border-base-300/60 px-2.5 py-0.5 text-[10px] uppercase tracking-widest text-base-content/60">
            {t.tag}
          </span>
        </li>
      ))}
    </ol>
  </section>

  <!-- CTA -->
  <section class="container-wide py-16">
    <div class="rounded-box border border-base-300/60 bg-gradient-to-br from-base-200/60 to-base-100 p-8 md:p-14">
      <div class="grid items-center gap-8 md:grid-cols-2">
        <div>
          <p class="section-label">~/connect</p>
          <h2 class="font-display text-3xl sm:text-4xl">Mau waltz bareng?</h2>
          <p class="mt-3 max-w-md text-base-content/70">
            Terbuka untuk kolaborasi, residensi, pertunjukan, dan percakapan. Kirim ide, kirim suara, kirim gambar.
          </p>
        </div>
        <div class="flex flex-wrap gap-3 md:justify-end">
          <a href="/contact/" class="btn btn-primary">Hubungi Kami</a>
          <a href="/blog/" class="btn btn-outline">Baca Catatan</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
