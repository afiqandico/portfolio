---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const slug = (id: string) => id.replace(/\.md$/, '');

const fmt = (d: Date) =>
  d.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
---
<BaseLayout title="Catatan" description="Catatan pendek dari Another Waltz — di balik karya,展览, dan percakapan kami.">
  <section class="container-wide py-16 md:py-20">
    <p class="section-label">Catatan</p>
    <h1 class="font-display text-5xl sm:text-6xl">
      Tulisan &amp; <em class="text-primary">cerita</em>.
    </h1>
    <p class="mt-4 max-w-2xl text-base-content/70">
      Bukan essay panjang. Bukan tutorial. Hanya catatan tentang apa yang sedang kami pikirkan, dengarkan, dan rasakan.
    </p>
  </section>

  <section class="container-wide pb-20">
    {posts.length === 0 && (
      <p class="rounded-box border border-base-300/60 bg-base-200/40 p-8 text-center text-base-content/70">
        Belum ada catatan. Tulis yang pertama di <code class="rounded bg-base-200 px-1">src/content/blog/</code>.
      </p>
    )}

    <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post, i) => (
        <li class="animate-fade-up" style={`animation-delay: ${i * 60}ms`}>
          <a href={`/blog/${slug(post.id)}/`}
             class="card-hover group flex h-full flex-col overflow-hidden rounded-box border border-base-300/60 bg-base-200/30">
            {post.data.heroImage && (
              <div class="aspect-[16/10] overflow-hidden">
                <img
                  src={post.data.heroImage}
                  alt={post.data.heroAlt ?? post.data.title}
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                />
              </div>
            )}
            <div class="flex flex-1 flex-col gap-2 p-5">
              <p class="text-xs text-base-content/50">{fmt(post.data.pubDate)}</p>
              <h2 class="font-display text-xl leading-tight transition-colors group-hover:text-primary">
                {post.data.title}
              </h2>
              <p class="text-sm text-base-content/70">{post.data.description}</p>
              {post.data.tags.length > 0 && (
                <div class="mt-auto flex flex-wrap gap-1.5 pt-2">
                  {post.data.tags.map(t => (
                    <span class="rounded-full border border-base-300/60 px-2 py-0.5 text-[10px] uppercase tracking-widest text-base-content/60">
                      #{t}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
