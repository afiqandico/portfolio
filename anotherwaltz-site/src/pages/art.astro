---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';

// Lukisan — moved from pahchinsan-developer
const paintings = [
  {
    title: 'Anger Of The Sun',
    size: '70x60 cm',
    year: '2019',
    desc: 'Cat genteng di kanvas. Waktu itu marah, matahari jadi satu-satunya bentuk yang bisa nerima itu.',
    img: '/art/anger-of-the-sun.svg',
  },
  {
    title: 'Bright Blue Sky',
    size: '90x60 cm',
    year: '2019',
    desc: 'Counter-nya Anger. Tiga hari setelah Anger kelar, langit Bali kebiruan — gak bisa diabaikan.',
    img: '/art/bright-blue-sky.svg',
  },
  {
    title: 'Dance',
    size: '70x60 cm',
    year: '2020',
    desc: 'Figur yang ditempatkan secara acak — bukan menari, lebih seperti being in motion.',
    img: '/art/dance.svg',
  },
  {
    title: 'Fake Rainbow',
    size: '70x60 cm',
    year: '2020',
    desc: 'Self-criticism: pelangi itu cliché. Tapi tetep stunning kalau kamu lihat di langit Bali setelah hujan.',
    img: '/art/fake-rainbow.svg',
  },
  {
    title: 'Flame Dance',
    size: '100x100 cm',
    year: '2021',
    desc: 'Yang pertama square format. Ukuran paling besar di seri awal. Cathartic.',
    img: '/art/flame-dance.svg',
  },
];
---
<BaseLayout
  title="Lukisan"
  description="Lima lukisan cat genteng karya Ruby Rubhin — Anger Of The Sun, Bright Blue Sky, Dance, Fake Rainbow, Flame Dance. Medium: cat genteng di kanvas, 2019-2021."
>
  <section class="container-wide py-16 md:py-24">
    <p class="section-label">~/paintings</p>
    <h1 class="font-display text-5xl sm:text-6xl">
      5 lukisan <em class="text-primary">cat genteng</em>.
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-base-content/75">
      Medium favorit saya — murah, tebal, gampang dikoreksi. Teksturnya gak bisa bohong, jadi <em>honest</em> by default. Seri pertama yang <em>survive</em> dari periode 2019–2021.
    </p>
  </section>

  <section class="container-wide pb-16 md:pb-24">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {paintings.map(p => (
        <article class="card-hover group overflow-hidden rounded-box border border-base-300/60 bg-base-200/30">
          <div class="aspect-[4/3] overflow-hidden">
            <img
              src={p.img}
              alt={p.title}
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
          </div>
          <div class="space-y-2 p-5">
            <div class="flex items-baseline justify-between gap-2">
              <p class="font-display text-lg">{p.title}</p>
              <span class="font-mono text-xs text-base-content/50">{p.year}</span>
            </div>
            <p class="font-mono text-[10px] uppercase tracking-widest text-base-content/40">{p.size}</p>
            <p class="text-sm text-base-content/70">{p.desc}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="border-t border-base-300/60 bg-base-200/30 py-16 md:py-24">
    <div class="container-wide">
      <p class="section-label">~/filsuf</p>
      <h2 class="mb-10 font-display text-3xl sm:text-4xl">Filosofi medium.</h2>
      <div class="grid gap-6 md:grid-cols-2">
        <div>
          <p class="prose-waltz">
            Cat akrilik bisa ditutup <em>smooth</em>, cat minyak bisa di-<em>blend</em> halus. Cat genteng? Kalau kamu taruh, dia <em>tetap ada di situ</em>, dengan semua ketidaksempurnaan dan konturnya.
          </p>
          <p class="prose-waltz mt-4">
            Itu <em>permission</em> yang saya butuhkan sebagai pemula. Plus, <em>honest</em> — dia <em>forces</em> kamu untuk tidak <em>smooth</em>-kan semuanya.
          </p>
        </div>
        <div>
          <p class="prose-waltz">
            Dari lima ini, saya sadar satu hal: <strong>saya lebih suka hitam-putih dengan percikan warna</strong>, bukan lukisan <em>full color</em>. Dan <strong>figur yang ditempatkan secara acak</strong> lebih menarik daripada figur yang <em>posed</em>.
          </p>
          <p class="prose-waltz mt-4">
            Itu yang kemudian jadi <em>signature</em>: organik, spontan, hitam-putih dominan, warna hanya di momen-momen <em>punctuation</em>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="container-wide py-16">
    <div class="rounded-box border border-base-300/60 bg-base-200/30 p-6">
      <p class="prose-waltz italic">
        Lukisan ini di-render sebagai SVG abstrak — representasi <em>mood</em> dan <em>komposisi</em>, bukan replika pixel-perfect. Kalau mau lihat aslinya, mampir ke <a href="/contact/" class="text-primary underline decoration-primary/40 underline-offset-4 hover:decoration-primary">studio</a> (janji temu dulu).
      </p>
    </div>
  </section>
</BaseLayout>
